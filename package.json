{
  "name": "bilan-carbone-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/application",
      "packages/db",
      "packages/shared",
      "packages/styles/*",
      "packages/tooling/*",
      "packages/publicodes-packages"
    ],
    "nohoist": []
  },
  "engines": {
    "node": "24.x",
    "yarn": "1.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:bc": "yarn --cwd apps/bc dev",
    "dev:mip": "turbo run dev --filter=mip",
    "bc": "yarn --cwd apps/bc dev",
    "bc:build": "yarn --cwd apps/bc build",
    "bc:test": "yarn --cwd apps/bc test",
    "bc:lint": "yarn --cwd apps/bc lint",
    "bc:ts": "yarn --cwd apps/bc ts",
    "mip:build": "yarn --cwd apps/mip build",
    "mip:test": "yarn --cwd apps/mip test",
    "mip:lint": "yarn --cwd apps/mip lint",
    "mip:ts": "yarn --cwd apps/mip ts",
    "build": "node packages/tooling/config/config-or-delete-cron.js && sh -c 'if [ \"$APP_TARGET\" = \"mip\" ]; then turbo run build --filter=mip; else turbo run build --filter=bilan-carbone; fi'",
    "test": "turbo run test",
    "start": "turbo run start",
    "ts": "turbo run ts",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prisma": "yarn workspace @abc-transitionbascarbone/db run prisma",
    "seed": "yarn seed:all",
    "seed:all": "yarn workspace @abc-transitionbascarbone/db tsx prisma/seed/index.ts --target all",
    "seed:bc": "yarn workspace @abc-transitionbascarbone/db tsx prisma/seed/index.ts --target bc",
    "seed:mip": "yarn workspace @abc-transitionbascarbone/db tsx prisma/seed/index.ts --target mip",
    "postinstall": "yarn db:generate",
    "db:generate": "rm -rf packages/data/db-common/src/generated/prisma && yarn workspace @abc-transitionbascarbone/db run db:generate",
    "compile:publicodes": "sh -c 'if [ \"$APP_TARGET\" = \"mip\" ]; then echo \"Skipping Publicodes compilation for MIP\"; else set -e; for dir in packages/publicodes-packages/publicodes-clickson packages/publicodes-packages/publicodes-count packages/publicodes-packages/publicodes-tilt; do (cd \"$dir\" && yarn compile); done; fi'",
    "compile:publicodes-windows": "for /d %d in (\"packages\\publicodes-packages\\publicodes-*\") do (@cd /d \"%d\" && yarn install && yarn compile && cd ..\\..\\..)"
  },
  "dependencies": {
    "next": "16.3.8"
  },
  "devDependencies": {
    "turbo": "^2.11.6"
  },
  "resolutions": {
    "@swc/core": "1.16.1",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1",
    "publicodes": "^1.10.3",
    "vite": "^6.4.3"
  }
}
