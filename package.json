{
  "name": "bilan-carbone-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/application",
      "packages/db",
      "packages/shared",
      "packages/styles/*",
      "packages/tooling/*",
      "packages/publicodes-packages"
    ],
    "nohoist": []
  },
  "engines": {
    "node": "24.x",
    "yarn": "1.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:bc": "yarn --cwd apps/bc dev",
    "dev:mip": "turbo run dev --filter=mip",
    "bc": "yarn --cwd apps/bc dev",
    "bc:build": "yarn --cwd apps/bc build",
    "bc:test": "yarn --cwd apps/bc test",
    "bc:lint": "yarn --cwd apps/bc lint",
    "bc:ts": "yarn --cwd apps/bc ts",
    "mip:build": "yarn --cwd apps/mip build",
    "mip:test": "yarn --cwd apps/mip test",
    "mip:lint": "yarn --cwd apps/mip lint",
    "mip:ts": "yarn --cwd apps/mip ts",
    "build": "node packages/tooling/config/config-or-delete-cron.js && sh -c 'if [ \"$APP_TARGET\" = \"mip\" ]; then turbo run build --filter=mip; else turbo run build --filter=bilan-carbone; fi'",
    "test": "turbo run test",
    "start": "turbo run start",
    "ts": "turbo run ts",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prisma": "yarn workspace @abc-transitionbascarbone/db-common run prisma",
    "seed": "yarn seed:all",
    "seed:all": "yarn workspace @abc-transitionbascarbone/db-common tsx prisma/seed/index.ts --target all",
    "seed:bc": "yarn workspace @abc-transitionbascarbone/db-common tsx prisma/seed/index.ts --target bc",
    "seed:mip": "yarn workspace @abc-transitionbascarbone/db-common tsx prisma/seed/index.ts --target mip",
    "postinstall": "yarn db:generate && yarn publicodes:compile",
    "db:generate": "rm -rf packages/db/src/generated/prisma && yarn workspace @abc-transitionbascarbone/db-common run db:generate",
    "publicodes:compile": "yarn workspace @abc-transitionbascarbone/publicodes-packages compile",
    "publicodes:test": "yarn workspace @abc-transitionbascarbone/publicodes-packages test",
    "publicodes:test:count": "yarn workspace @abc-transitionbascarbone/publicodes-packages test:count",
    "publicodes:test:clickson": "yarn workspace @abc-transitionbascarbone/publicodes-packages test:clickson",
    "publicodes:test:tilt": "yarn workspace @abc-transitionbascarbone/publicodes-packages test:tilt",
    "publicodes:compile-windows": "yarn workspace @abc-transitionbascarbone/publicodes-packages compile"
  },
  "dependencies": {
    "next": "16.3.3"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "resolutions": {
    "publicodes": "^1.10.1",
    "@publicodes/react-ui": "^1.10.0",
    "@hono/node-server": "^2.0.5",
    "@babel/core": "^7.29.6",
    "qs": "6.16.0",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8",
    "hono": "^4.12.18",
    "postcss": "^8.5.25",
    "fast-uri": "^3.1.4",
    "fast-xml-builder": "^1.1.6",
    "uuid": "^14.0.1",
    "js-yaml": "^4.3.0",
    "sharp": "0.35.4",
    "ws": "^8.21.0",
    "tmp": "^0.2.6",
    "systeminformation": "^5.31.7",
    "nanoid": "^3.3.18",
    "vite": "^6.4.3",
    "mysql2": "^3.22.0",
    "deepmerge-ts": "^8.0.0"
  }
}
