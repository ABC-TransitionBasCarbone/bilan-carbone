{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["cypress", "node", "jest"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@abc-transitionbascarbone/css": ["../../packages/css/index.ts"]
    }
