{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "types": ["cypress", "node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@abc-transitionbascarbone/css": ["../../packages/common/components/ui/css/index.ts"],
      "@abc-transitionbascarbone/publicodes-packages/count": [
        "../../packages/publicodes-packages/publicodes-count/publicodes-build"
      ],
      "@abc-transitionbascarbone/publicodes-packages/clickson": [
        "../../packages/publicodes-packages/publicodes-clickson/publicodes-build"
      ],
      "@abc-transitionbascarbone/publicodes-packages/tilt": [
        "../../packages/publicodes-packages/publicodes-tilt/publicodes-build"
      ]
    }
  },
  "ts-node": {
    "experimentalResolver": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cypress/**/*.ts",
    "**/*.cy.ts",
    "prisma/**/*.ts",
    "../../packages/common/types/*",
    "../../packages/common/services/results/posts.enums.ts",
    "../../packages/common/tooling/tests/utils/models/translationsMock.tsx",
    "../../packages/common/utils/environmentClient.ts"
  ],
  "exclude": ["node_modules", "../../packages/publicodes-packages"]
}
