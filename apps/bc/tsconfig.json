{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "types": [
      "cypress",
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@abc-transitionbascarbone/css": [
        "../../packages/application/components/ui/css/index.ts"
      ],
      "@abc-transitionbascarbone/publicodes-packages/count": [
        "../../packages/publicodes-packages/publicodes-count/publicodes-build"
      ],
      "@abc-transitionbascarbone/publicodes-packages/clickson": [
        "../../packages/publicodes-packages/publicodes-clickson/publicodes-build"
      ],
      "@abc-transitionbascarbone/publicodes-packages/tilt": [
        "../../packages/publicodes-packages/publicodes-tilt/publicodes-build"
      ]
    }
  },
  "ts-node": {
    "experimentalResolver": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cypress/**/*.ts",
    "**/*.cy.ts",
    "prisma/**/*.ts",
    "../../packages/shared/types/*",
    "../../packages/shared/services/results/posts.enums.ts",
    "../../packages/shared/tooling/tests/utils/models/translationsMock.tsx",
    "../../packages/shared/utils/environmentClient.ts"
  ],
  "exclude": [
    "node_modules",
    "../../packages/publicodes-packages"
  ]
}
