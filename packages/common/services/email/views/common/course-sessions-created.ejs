<html>
  <%- include('../partials/style'); %>
  <body>
    <div>
      <p>Bonjour,</p>
      <br />
      <p>Vos nouvelles sessions de formation ont été créées. Voici leur récapitulatif :</p>
      <% for (const session of sessions) { %>
      <hr />
      <h2><%= session.name %></h2>
      <p><strong>Environnement :</strong> <%= session.environment %></p>
      <p><strong>Dates :</strong> du <%= session.startDate %> au <%= session.endDate %></p>
      <h3>Codes d'accès</h3>
      <p><strong>Code stagiaires :</strong> <%= session.traineeCode %></p>
      <p><strong>Code formateur :</strong> <%= session.professorCode %></p>
      <% if (session.professor) { %>
      <h3>Formateur</h3>
      <p><%= session.professor.firstName %> <%= session.professor.lastName %> — <%= session.professor.email %></p>
      <% } %>
      <h3>Stagiaires intégrés (<%= session.trainees.length %>)</h3>
      <% if (session.trainees.length) { %>
      <ul>
        <% for (const trainee of session.trainees) { %>
        <li><%= trainee.firstName %> <%= trainee.lastName %> — <%= trainee.email %></li>
        <% } %>
      </ul>
      <% } else { %>
      <p>Aucun stagiaire intégré.</p>
      <% } %>
      <% } %>
      <hr />
      <br />
      <%- include('./partials/signature'); %>
    </div>
  </body>
</html>
