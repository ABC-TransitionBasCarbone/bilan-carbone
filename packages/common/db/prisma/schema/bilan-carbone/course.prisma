model CourseOrganism {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  name           String
  contactEmail   String          @map("contact_email")
  ftpPath        String          @map("ftp_path")
  courseSessions CourseSession[]

  @@unique([name])
  @@map("course_organism")
  @@schema("bilan_carbone")
}

model SessionCode {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  traineeCode    String          @map("trainee_code")
  professorCode  String?         @map("professor_code")
  courseSessions CourseSession[]

  @@unique([traineeCode])
  @@unique([professorCode])
  @@map("session_code")
  @@schema("bilan_carbone")
}

model CourseSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  organizationVersion   OrganizationVersion @relation(fields: [organizationVersionId], references: [id], onDelete: Cascade)
  organizationVersionId String              @map("organization_version_id")

  courseOrganism   CourseOrganism @relation(fields: [courseOrganismId], references: [id], onDelete: Cascade)
  courseOrganismId String         @map("course_organism_id")

  sessionCode   SessionCode? @relation(fields: [sessionCodeId], references: [id], onDelete: Cascade)
  sessionCodeId String?      @map("session_code_id")

  @@unique([organizationVersionId])
  @@unique([sessionCodeId])
  @@map("course_session")
  @@schema("bilan_carbone")
}
