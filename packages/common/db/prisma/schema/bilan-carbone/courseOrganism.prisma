model CourseOrganism {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  name         String
  contactEmail String @map("contact_email")
  ftpPath      String @map("ftp_path")

  courseSessions CourseSession[]

  @@unique([name])
  @@map("course_organism")
  @@schema("bilan_carbone")
}

model CourseSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  name        String
  type        String?
  environment Environment
  code        String      @unique

  courseOrganism   CourseOrganism @relation(fields: [courseOrganismId], references: [id], onDelete: Cascade)
  courseOrganismId String         @map("course_organism_id")

  professorOrganization          OrganizationVersion? @relation("CourseSessionProfessor", fields: [professorOrganizationVersionId], references: [id], onDelete: SetNull)
  professorOrganizationVersionId String?              @map("professor_organization_version_id")

  traineeOrganizations CourseSessionTraineeOrganization[]

  @@unique([courseOrganismId, name, environment])
  @@map("course_session")
  @@schema("bilan_carbone")
}

model CourseSessionTraineeOrganization {
  courseSessionId String        @map("course_session_id")
  courseSession   CourseSession @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)

  organizationVersionId String              @map("organization_version_id")
  organizationVersion   OrganizationVersion @relation(fields: [organizationVersionId], references: [id], onDelete: Cascade)

  courseStatus CourseSessionTraineeOrganizationStatus @default(INACTIVE) @map("is_active")

  @@id([courseSessionId, organizationVersionId])
  @@index([organizationVersionId])
  @@map("course_session_trainee_organization")
  @@schema("bilan_carbone")
}

enum CourseSessionTraineeOrganizationStatus {
  INACTIVE
  ACTIVE

  @@schema("bilan_carbone")
}
