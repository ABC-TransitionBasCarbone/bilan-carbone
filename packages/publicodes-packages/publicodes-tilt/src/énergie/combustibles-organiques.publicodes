#     toutes ces conditions:
#       - est défini: choix
#       - choix != "aucun"
#   titre: Combustibles organiques
#   formule:
#     somme:
#       - granulés
#       - bois
#   par défaut: 0
#   unité: kgCO2e

# énergie . combustibles organiques . choix:
#   question: Utilisez-vous des bûches ou des granulés ?
#   par défaut: 0
#   une possibilité:
#     - bûches
#     - granulés
#     - aucun
#   avec:
#     bûches:
#       titre: Bûches
#     granulés:
#       titre: Granulés
#     aucun:
#       titre: Aucun

# énergie . combustibles organiques . granulés:
#   titre: Bois granulés
#   formule: consommation * FE
#   unité: kgCO2e
#   par défaut: 0
#   avec:
#     consommation:
#       question: Combien de kWh issus de la combustion de granulés de bois ont été consommés chaque année ?
#       unité: kWh
#       par défaut: 0
#     FE:
#       valeur: 0.5198
#       note: 0,0113 kgCO2e/kWh avec 4,6 kWh pour un kg (cf Empreinte Carbone Personnelle)
#       unité: kgCO2e/kg
#       meta:
#         id: 34942

# énergie . combustibles organiques . bois:
#   titre: Bois bûches
#   formule: consommation * FE
#   unité: kgCO2e
#   avec:
#     consommation:
#       question: Quelle est votre consommation annuelle de bois ?
#       unité: stères
#       par défaut: 0
#     FE:
#       valeur: 74.06
#       note: 0,046 kgCO2e/kWh avec 1610 kWh pour un stère (cf Empreinte Carbone Personnelle)
#       unité: kgCO2e/stère
#       meta:
#         id: 25834

énergie . combustibles organiques . types:
  titre: Types d'énergie
  avec:
    électricité présent:
      type: booléen
      question: Électricité
      form:
        saisie: case à cocher
      par défaut: oui

    gaz présent:
      type: booléen
      question: Gaz
      form:
        saisie: case à cocher
      par défaut: non

#   mosaique:
#      type: nombre
#      options:
#        - électricité . présent
#        - gaz . présent
#        - fioul . présent
#        - bois . présent
#        - granulés . présent
#        - réseaux de chaleur . présent
#        - réseaux de froid . présent
#        - panneaux PV ou chauffe eau solaire . présent
#   question: Quels types d'énergies utilisez-vous pour le chauffage, l'éclairage et les autres consommations énergétiques de vos locaux ?
#   titre: Types d'énergie utilisés
#   suggestions:
#     aucun:
#       électricité . présent: oui
#       gaz . présent: non
#       fioul . présent: non
#       bois . présent: non
#       granulés . présent: non
#       réseaux de chaleur . présent: non
#       réseaux de froid . présent: non
#       panneaux PV ou chauffe eau solaire . présent: non
#   note: Pour proposer des réponses par défaut en fonction des mètres-carrés renseignés pour les locaux, il faut spécifiquement demander si la chaudière des locaux est électrique.

# énergie . types . électricité . présent:
#  question: Utilisez-vous de l'électricité pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: oui

# énergie . types . gaz . présent:
#  question: Utilisez-vous du gaz pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . fioul . présent:
#  question: Utilisez-vous du fioul pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . bois . présent:
#  question: Utilisez-vous du bois pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . granulés . présent:
#  question: Utilisez-vous des granulés pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . réseaux de chaleur . présent:
#  question: Utilisez-vous des réseaux de chaleur pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . réseaux de froid . présent:
#  question: Utilisez-vous des réseaux de froid pour le chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#  par défaut: non

# énergie . types . panneaux PV ou chauffe eau solaire . présent:
#   question: Utilisez-vous des panneaux photovoltaïques ou un chauffe-eau solaire pour le  chauffage, l'éclairage ou les autres consommations énergétiques de vos locaux ?
#   par défaut: non

énergie . combustibles organiques . types . chauffage électrique: 
  question: Le chauffage de vos locaux est-il électrique ? 
  description: Cette information sert à proposer des estimations de consommations pour l'électricité par la suite. Les estimations incluent le chauffage si celui-ci est électrique. 

énergie . combustibles organiques . emissions:
  ordre: 3
  icônes:
  mosaique:
    type: nombre
    options:
      - électricité . consommation
      - gaz . consommation
      # - fioul . consommation
      # - bois . consommation
      # - granulés . consommation
      # - réseaux de chaleur . consommation
      # - réseaux de froid . consommation
      # - panneaux PV ou chauffe eau solaire . consommation
  question: Veuillez indiquer vos consommations d'énergie pour les types d'énergie suivants
  titre: Consommations énergétiques
  description: Par défaut, des valeurs sont saisies en fonction des mètres-carrés que vous avez renseignés pour vos locaux, Ces valeurs sont issues de données statistiques de la Base Empreinte, Elles sont imprécises et datées, Si vous disposez de données plus précises via vos factures ou autres éléments de suivi, nous vous invitons à les renseigner à la place des données par défaut
  formule: 
    somme:
      - électricité
      - gaz
      # - fioul
      # - bois
      # - granulés
      # - réseaux de chaleur
      # - réseaux de froid
      # - panneaux PV ou chauffe eau solaire
  note:

énergie . combustibles organiques . emissions . électricité:
  titre: Électricité
  formule: consommation * FE
  unité: kgCO2e
  par défaut: 0
  avec:
    FE:
      valeur: 0.0461
      unité: kgCO2e/kWh
      meta:
        nom: Electricité/2025 - mix moyen/consommation
        id: 48788
        source: Base Empreinte®

énergie . combustibles organiques . emissions . électricité . consommation:
  applicable si:
    toutes ces conditions:
      - est défini:  types . électricité présent
      - types . électricité présent = oui
  question: Quelle est votre consommation annuelle d'électricité ? 
  titre: Consommation annuelle d'électricité
  description: Cette consommation doit être issue de votre facture et ne pas inclure pas votre autoconsommation (panneaux solaires, etc), ni la consommation des véhicules électriques qui est prise en compte au sein d'autres catégories (Fret, Déplacements).
  unité: kWh
  par défaut: construction . bâtiment . surface finale * donnée statistique

énergie . combustibles organiques . emissions . électricité . donnée statistique:
  titre: Consommation moyenne d'électricité pour des bureaux à l'année, statistiques Base Carbone® (hors ou avec chauffage)
  applicable si:
    toutes ces conditions:
      - est défini: énergie . combustibles organiques . types . chauffage électrique
  valeur:
    variations:
      - si: énergie . combustibles organiques . types . chauffage électrique = oui
        alors: 283
      - sinon: 121
  unité: kWh/m².an

énergie . combustibles organiques . emissions . gaz:
  titre: Gaz naturel
  formule: consommation * FE
  unité: kgCO2e
  par défaut: 0
  avec:
    FE:
      valeur: 2.32
      unité: kgCO2e/m3
      meta:
        nom: Gaz naturel - 2022/mix moyen/consommation
        id: 37138
        source: Base Carbone®

énergie . combustibles organiques . emissions . gaz . consommation:
  applicable si:
    toutes ces conditions:
      - est défini:  énergie . combustibles organiques . types . gaz présent
      - énergie . combustibles organiques . types . gaz présent = oui
  question: Quelle est votre consommation annuelle de gaz naturel ? 
  titre: Gaz naturel
  unité: m3
  par défaut: construction . bâtiment . surface finale * donnée statistique
  avec: 
    donnée statistique:
      valeur: 164
      unité: m3/m².an
      meta: 
        nom: Consommation moyenne de gaz naturel pour des bureaux à l'année, statistiques Base Carbone® (la statistique originelle est en kWh PCI/m².an)