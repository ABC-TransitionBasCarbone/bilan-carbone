événement . énergie:
  formule:
    somme:
      - électricité
      - gaz
      - fioul
  par défaut: 0

événement . énergie . types: 
  titre: Types d'énergie
  avec:
    électricité présent:
      type: booléen
      question: Électricité
      form:
        saisie: case à cocher
      par défaut: oui

    gaz présent:
      type: booléen
      question: Gaz
      form:
        saisie: case à cocher
      par défaut: non

    fioul présent:
      type: booléen
      question: Fioul domestique
      form:
        saisie: case à cocher
      par défaut: non

événement . énergie . électricité:
  applicable si:
    toutes ces conditions:
      - est défini: types . électricité présent
      - types . électricité présent = oui
  titre: Quelle a été la consommation d'électricité au cours de l'événement ?
  formule: consommation * FE
  unité: kgCO2e
  par défaut: 0 
  avec: 
    consommation:
      question: Quelle a été la consommation d'électricité au cours de l'événement ?
      unité: kWh
    FE:
      valeur: 0.0461
      unité: kgCO2e/kWh
      meta:
        nom: Electricité/2025 - mix moyen/consommation
        id: 48788
        source: Base Empreinte®

