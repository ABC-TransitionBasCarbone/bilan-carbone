déplacements . DT-bénévoles:
  titre: Emissions des trajets domicile-association des bénévoles
  formule:
    somme:
      # - avec
      - sans
  unité: kgCO2e
  par défaut: 0

## Cette fonction permet de calculer les émissions des bénévoles qui n'ont pas répondu à MEP à partir des kms moyens parcourus par ceux qui ont répondu, on utilise le split moyen français par mode pour les DT comme FE pour extrapoler
#GC : Commenté car pas de MIP à la sortie. Remettre la somme "avec" et tous les applicables si dans les questions "sans" si on ajoute MIP. Idem pour tous les autres fichiers, faire des Ctrl+F

# déplacements . DT-bénévoles . avec:
#   applicable si:
#     toutes ces conditions:
#       - est défini: déplacements . DT-salariés . MEP présent
#       - déplacements . DT-salariés . MEP présent = oui
#   titre: émissions des trajets domicile-association des bénévoles (avec enquête MEP)
#   formule:
#     somme:
#       - produit:
#           - distance
#           - répartition
#           - (5 - télétravail . bénévoles . j)
#           - commun . nombre de semaines travaillées par an
#           - (général . bénévoles - déplacements . DT-salariés . MEP présent . nombre bénévoles)
#           # Pour la même raison que plus bas, j'enlève le taux d'occupation ici
#           # - 1 / sans . voiture . occupation
#       - réponse MEP
#   avec:
#     distance:
#       question: D'après les résultats de MEP, quelle est la distance moyenne parcourue par jour (A/R) par bénévole pour des déplacements domicile-travail ?
#       unité: km
#       par défaut: 0
#     répartition:
#       formule: voiture * 0.76 + transports en commun * 0.16 + deux roues * 0.02 + actif * 0.09
#       note: Source de la répartition https://www.insee.fr/fr/statistiques/6454112
#       avec:
#         voiture:
#           valeur: déplacements . DM-salariés . sans . voiture . split
#           unité: kgCO2e/km
#           par défaut: 0
#         transports en commun:
#           valeur: déplacements . DM-salariés . sans . transports en commun . split
#           unité: kgCO2e/km
#           par défaut: 0
#         deux roues:
#           valeur: 0.0851
#           unité: kgCO2e/km
#           par défaut: 0
#           meta:
#             id: 43775
#             nom: Cyclomoteur/Mixte/2023
#         actif:
#           valeur: 0
#           unité: kgCO2e/km
#           par défaut: 0
#           note: On néglige l'impact des modes actifs (vélo, marche, trottinette...)
#     réponse MEP:
#       question: D'après les résultats MEP, combien de kgCO2e représentent les déplacements domicile-association des bénévoles ?
#       unité: kgCO2e
#       par défaut: 0
#   unité: kgCO2e
#   par défaut: 0

## Ici on calcule les émissions dans le cas ou il n'y pas eu de campagne MEP

déplacements . DT-bénévoles . sans:
  titre: émissions des trajets domiciles travail des bénévoles (sans enquête MEP)
  formule:
    somme:
      - voiture * part voiture
      - train * part train
      - bus * part bus
      - deux roues * part deux roues
      - transports en commun * part transport en commun
  unité: kgCO2e
  par défaut: 0

déplacements . DT-bénévoles . sans . part voiture:
  titre: Voiture
  form:
    à traduire: oui
 # applicable si:
 #   toutes ces conditions:
 #     - est défini: déplacements . DT-salariés . MEP présent
 #     - déplacements . 
  question: Quand les bénévoles se déplacent, quel pourcentage d'entre eux utilise la voiture ?
  unité: "%"
  par défaut: 0

déplacements . DT-bénévoles . sans . part train:
  titre: Train (TER)
  form:
    à traduire: oui
 # applicable si:
 #   toutes ces conditions:
 #     - est défini: déplacements . DT-salariés . MEP présent
 #     - déplacements . 
  question: Quand les bénévoles se déplacent, quel pourcentage d'entre eux utilise le train ?
  unité: "%"
  par défaut: 0

déplacements . DT-bénévoles . sans . part bus:
  titre: Bus
  form:
    à traduire: oui
 # applicable si:
 #   toutes ces conditions:
 #     - est défini: déplacements . DT-salariés . MEP présent
 #     - déplacements . 
  question: Quand les bénévoles se déplacent, quel pourcentage d'entre eux utilise le bus ?
  unité: "%"
  par défaut: 0

déplacements . DT-bénévoles . sans . part deux roues:
  titre: Deux roues (moto, scooter, ...)
  form:
    à traduire: oui
 # applicable si:
 #   toutes ces conditions:
 #     - est défini: déplacements . DT-salariés . MEP présent
 #     - déplacements . 
  question: Quand les bénévoles se déplacent, quel pourcentage d'entre eux utilise un deux roues ?
  unité: "%"
  par défaut: 0

déplacements . DT-bénévoles . sans . part transport en commun:
  titre: Transports en commun (Métro, tramway, RER, bus, ...)
  form:
    à traduire: oui
 # applicable si:
 #   toutes ces conditions:
 #     - est défini: déplacements . DT-salariés . MEP présent
 #     - déplacements . 
  question: Quand les bénévoles se déplacent, quel pourcentage d'entre eux utilise les transports en commun (Métro, Tramway, Bus) ?
  unité: "%"
  par défaut: 0

déplacements . DT-bénévoles . sans . voiture:
  titre: Voiture
  form:
    à traduire: oui
  applicable si:
    toutes ces conditions:
      - est défini: part voiture
      - part voiture > 0
  formule: distance * commun . FE . moyen de transport . voiture moyenne France * général . bénévoles * commun . nombre de semaines travaillées par an * (5 - télétravail . bénévoles . j)
  avec:
    distance:
      question: Quand les bénévoles se déplacent en voiture, combien de km parcourent-ils en moyenne par jour (A/R) ? 
      type: nombre
      unité: km/bénévoles.jours
      par défaut: 31.8
  description: On considère ici toutes les motorisations de voiture individuelles, basée sur des moyennes nationales
  unité: kgCO2e
  par défaut: 0

déplacements . DT-bénévoles . sans . voiture . occupation:
  formule: 1.08
  note: source pour le taux d'occupation d'une voiture en France pour des trajets D-T https://www.citego.org/bdf_fiche-document-3431_fr.html
  unité: unité

déplacements . DT-bénévoles . sans . train:
  titre: Train (TER)
  form:
    à traduire: oui
  applicable si:
    toutes ces conditions:
      - est défini: part train
      - part train > 0
  formule: distance * FE * général . bénévoles * commun . nombre de semaines travaillées par an * (5 - télétravail . bénévoles . j)
  avec:
    distance:
      question: Quand les bénévoles se déplacent en train, combien de km parcourent-ils en moyenne par jour (A/R) ? 
      unité: km/bénévoles.jours
      par défaut: 29.4
    FE:
      valeur: 0.0277
      unité: kgCO2e/km
      meta:
        id: 43255
        nom: TER/2022/Traction moyenne
        note: On considère que la majorité des déplacements en train pour du DT est en TER
  unité: kgCO2e
  par défaut: 0

déplacements . DT-bénévoles . sans . bus:
  titre: Bus
  form:
    à traduire: oui
  applicable si:
    toutes ces conditions:
      - est défini: part bus
      - part bus > 0
  formule: distance * commun . FE . moyen de transport . bus * général . bénévoles * commun . nombre de semaines travaillées par an * (5 - télétravail . bénévoles . j)
  avec:
    distance:
      question: Quand les bénévoles se déplacent en train, combien de km parcourent-ils en moyenne par jour (A/R) ? 
      unité: km/bénévoles.jours
      par défaut: 29.4
  unité: kgCO2e
  par défaut: 0

déplacements . DT-bénévoles . sans . transports en commun:
  titre: Transports en commun (Métro, tramway, RER, bus, ...)
  form:
    à traduire: oui
  applicable si:
    toutes ces conditions:
      - est défini: part transport en commun
      - part transport en commun > 0
  formule: distance * commun . FE . moyen de transport . transports en commun moyenne France * général . bénévoles * commun . nombre de semaines travaillées par an * (5 - télétravail . bénévoles . j)
  avec:
    distance:
      question: Quand les bénévoles se déplacent en transport en commun (métro, tramway, RER), combien de km parcourent-ils en moyenne par jour (A/R) ? 
      type: nombre
      unité: km/bénévoles.jours
      par défaut: 29.4
  unité: kgCO2e
  par défaut: 0

déplacements . DT-bénévoles . sans . deux roues:
  titre: Deux roues (Moto, scooter, ...)
  form:
    à traduire: oui
  applicable si:
    toutes ces conditions:
      - est défini: part deux roues
      - part deux roues > 0
  formule: distance * FE * général . bénévoles * commun . nombre de semaines travaillées par an * (5 - télétravail . bénévoles . j)
  avec:
    distance:
      question: Quand les bénévoles se déplacent en deux roues, combien de km parcourent-ils en moyenne par jour (A/R) ? 
      type: nombre
      unité: km/bénévoles.jours
      par défaut: 21.4
    FE:
      valeur: 0.0851
      unité: kgCO2e/km
      meta:
        id: 43775
        nom: Cyclomoteur/Mixte/2023
  unité: kgCO2e
