intrants-services . numérique:
  question: Veuillez indiquer les usages numériques en [Année] des salariés et bénévoles de votre association
  formule:
    somme:
      - streaming
      - visioconférence
      - mails
      - stockage-cloud
  unité: kgCO2e

intrants-services . numérique . streaming:
  formule: heures * FE
  avec:
    heures:
      question: Sur une année, combien d'heures de streaming vidéo ont été regardées ?
      description: Les heures passées sur internet d'une manière générale sont ignorées, car l'empreinte associée est généralement très faible.
      par défaut: 0
      unité: h

    FE:
      valeur: 0.0414
      unité: kgCO2e/h
      meta:
        nom: Streaming vidéo pendant 1h 720p 30 fps via une connexion fixe
        source: Base Empreinte®
        note: On se base sur le FE 720p 30fps via une connexion fixe.
  unité: kgCO2e

intrants-services . numérique . visioconférence:
  formule: heures * FE
  avec:
    heures:
      question: Sur une année, combien d'heures de visioconférence ont eu lieu ?
      par défaut: 0
      unité: h

    FE:
      valeur: 0.53
      unité: kgCO2e/h
      meta:
        nom: Webconférence d'une heure à 20 (connexion fixe)
        source: Base Empreinte®
        note: On majore volontairement en prenant le facteur d'émission le plus élevé. Idéalement, on souhaiterait aller vers un FE pour 5-6 personnes.
  unité: kgCO2e

intrants-services . numérique . mails:
  formule: nombre * FE
  avec:
    nombre:
      question: Sur une année, combien de mails ont été envoyés ?
      par défaut: 0
      unité: mail

    FE:
      valeur: 0.0171
      unité: kgCO2e/mail
      meta:
        nom: Envoi d'1 mail sans pièce jointe à 5 destinataires connexion fixe
        source: Base Empreinte®
  unité: kgCO2e

intrants-services . numérique . stockage-cloud:
  formule: volume * FE
  avec:
    volume:
      question: Sur une année, combien de Go de données ont été stockées sur un cloud ?
      par défaut: 0
      unité: Go

    FE:
      valeur: 0.0116
      unité: kgCO2e/Go
      meta:
        nom: Stockage de 1Go de données dans le cloud via une connexion fixe pendant 1 an
        source: Base Empreinte®
  unité: kgCO2e
