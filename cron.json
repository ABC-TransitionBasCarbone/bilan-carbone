{
  "jobs": [
    {
      "command": "0 3 * * * curl --silent --show-error --fail --output /dev/null -X POST $NEXT_API_URL/cron/deactivate-course-users -H \"Authorization: Bearer $CRON_SECRET\"",
      "description": "Downgrade expired course trainees to members every day at 03:00 (scheduler timezone)"
    },
    {
      "command": "*/10 * * * * curl --silent --show-error --fail --output /dev/null -X POST $NEXT_API_URL/cron/import-users -H \"Authorization: Bearer $CRON_SECRET\"",
      "description": "Import users from FTP server every 10 minutes"
    },
    {
      "command": "*/10 * * * * curl --silent --show-error --fail --output /dev/null -X POST $NEXT_API_URL/cron/import-training-sessions -H \"Authorization: Bearer $CRON_SECRET\"",
      "description": "Import training sessions from FTP server every 10 minutes"
    },
    {
      "command": "0 1 * * * curl --silent --show-error --fail --output /dev/null -X POST $NEXT_API_URL/cron/assign-training-studies -H \"Authorization: Bearer $CRON_SECRET\"",
      "description": "Create training studies for users who started or ended a formation"
    }
  ]
}
